-- Bug: `mxcli diff` reported "(no changes)" for a script that changes an
-- association's storage, because neither side of the script differ rendered
-- storage. Storage is schema (junction table vs foreign-key column), so a
-- missed flip is a database migration nobody was shown.
--
-- Reproduce against a project:
--   mxcli exec association-storage-table-roundtrip.mdl -p app.mpr
--   (edit the last statement to `storage column`)
--   mxcli diff association-storage-table-roundtrip.mdl -p app.mpr
-- Expected: describe shows `storage table`; the diff of the unchanged script is
-- empty; the diff with `storage column` shows the storage hunk.

create persistent entity BugTest.Customer (
  "Name": String(100)
);

create persistent entity BugTest.Order (
  "Number": Integer
);

create association BugTest.Order_Customer
from BugTest.Order to BugTest.Customer
storage table;

-- No storage clause: carries the stored Table rather than resetting to Column,
-- and `mxcli diff` of it reports no change.
create or modify association BugTest.Order_Customer
from BugTest.Order to BugTest.Customer;

describe association BugTest.Order_Customer;
