mdl 1;
-- Two member positions inside a widget that reference checking walked past.
-- Both passed `check --references`, passed `exec`, and failed the build.
--
-- 1. An XPATH CONSTRAINT naming a member the entity does not have
--    (mendixlabs/mxcli#1049). The check resolved the entity in
--    `database from Bench.Order` and never looked inside the `where […]`:
--
--      where [Bench.Order_Status = 'Open']
--      mx check -> [CE1613] "The selected association 'Bench.Order_Status'
--                  no longer exists." at Data grid 2 'gridOrders'
--
-- 2. A CONTENTPARAMS value rooted in a VARIABLE (mendixlabs/mxcli#1046) was
--    bound as an attribute and the writer kept `$Customer/` as part of the
--    attribute name (CE1613 "The selected attribute
--    'Bench.Customer.$Customer/Name' no longer exists"). MDL-WIDGET24 refused
--    it at check time. Since mendixlabs/mxcli#1406 the writer stores
--    `$Customer/Name` as the Mendix EXPRESSION it is — what Studio Pro stores
--    for an expression parameter, and what describe prints back — so the rule
--    is gone. `$currentObject/Assoc/Attr` is still bound over the association.
--
-- Verify — EXEC FIRST, for the reason the sibling example gives: members are
-- resolved against the model, so against an app that has never seen these
-- entities every step is unknowable and the file passes having checked nothing.
--
--   mxcli exec  widget-member-refs-resolved-at-check.mdl -p app.mpr
--   mxcli check widget-member-refs-resolved-at-check.mdl -p app.mpr --references
--   mx check -p app.mpr        -- 0 errors
--
-- Then perturb, one at a time, and re-check:
--
--   [Status = 'Open']         -> [Statuss = 'Open']
--     WidgetRefs.P_List: datagrid "gridOrders": the constraint on
--     WidgetRefs.Order names "Statuss", which is neither an attribute nor an
--     association of it — …
--
-- Template parameter shapes, measured on 11.13.0 by executing and building:
--
--   OrderNo                                       clean
--   WidgetRefs.Order_Customer/Name                clean  (association hop)
--   $currentObject/WidgetRefs.Order_Customer/Name clean  (prefix stripped)
--
-- and, since #1406, stored as an expression (a String member builds clean on
-- 11.6.6;
-- an expression parameter must be a String, CE0117 otherwise):
--
--   $currentObject/OrderNo
--   $Order/Name

create module WidgetRefs;

create or modify entity WidgetRefs.Customer (
  Name: String(200)
);

create or modify entity WidgetRefs.Order (
  OrderNo: String(50),
  Status: String(50)
);

create or modify association WidgetRefs.Order_Customer
  from WidgetRefs.Order to WidgetRefs.Customer type reference;

-- Every constraint here RESOLVES, which is the point: these are the shapes that
-- must not be reported.
create or modify page WidgetRefs.P_List
(
  Title: 'Orders',
  Layout: Atlas_Core.Atlas_Default
)
{
  -- A bare attribute of the constrained entity.
  datagrid gridOrders (datasource: database from WidgetRefs.Order where [Status = 'Open']) {
    column (attribute: OrderNo, caption: 'No')
  }

  -- An ASSOCIATION HOP and then an attribute of the entity it reaches. The walk
  -- has to carry the entity from step to step, or this reads as a member of
  -- Order and is wrongly reported.
  datagrid gridByCustomer (
    datasource: database from WidgetRefs.Order
      where [WidgetRefs.Order_Customer/WidgetRefs.Customer/Name = 'Acme']
  ) {
    column (attribute: OrderNo, caption: 'No')
  }
};

-- ContentParams written the way the position wants: the attribute name, or an
-- association path to one. No `$variable/` root.
create or modify page WidgetRefs.P_Detail
(
  params: ( $Order: WidgetRefs.Order ),
  title: 'Order',
  layout: Atlas_Core.Atlas_Default
)
{
  dataview dvOrder (datasource: $Order) {
    dynamictext dtNo (Content: 'Order {1}', ContentParams: ({1} = OrderNo))

    -- An association path is LEGAL here — it is an attribute reached over an
    -- association, stored as AttributeRef plus steps. Two segments, not three:
    -- the association then the attribute. The XPath spelling
    -- (`Assoc/Entity/Attr`) is NOT this, and mxbuild rejects it with the same
    -- CE1613 — measured, and the reason this line is written out rather than
    -- assumed.
    dynamictext dtCust (
      Content: 'for {1}',
      ContentParams: ({1} = WidgetRefs.Order_Customer/Name)
    )

    -- And `$currentObject/` IS stripped when an association path follows, so
    -- this builds cleanly too. A check that flagged every variable root would
    -- report it.
    dynamictext dtCust2 (
      Content: 'also {1}',
      ContentParams: ({1} = $currentObject/WidgetRefs.Order_Customer/Name)
    )
  }
};
