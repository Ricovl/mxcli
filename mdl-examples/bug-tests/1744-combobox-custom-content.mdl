mdl 1;
-- ============================================================================
-- ako/mxcli#1744 (mendixlabs/mxcli#1663) — a combo box's custom content
-- ============================================================================
--
-- `mxcli widget describe combobox` listed optionsSourceAssociationCustomContent
-- and optionsSourceDatabaseCustomContent as `widgets` properties, but a block
-- for one was refused: MDL-WIDGET26 "`optionssourceassociationcustomcontent` is
-- not a container of `combobox`, which declares no containers". The type that
-- switches the content on WAS written, so `…CustomContentType: 'yes'` on its
-- own passed check and exec and failed mx check with CE0642 "Property 'Custom
-- content' is required." at Widgets container 'Custom content' of combo box.
--
-- Expected now: each mode's custom content is a container of `combobox` — the
-- association mode's in association mode, the database mode's in database
-- mode — its widgets bind to the OPTION entity, and `describe page` prints the
-- block back, so describe -> exec reports "Unchanged page". The other mode's
-- block is refused (MDL-WIDGET30), naming the one this mode has.

create module Bug1744;
create or modify persistent entity Bug1744.Person ( NameEN: String(200), NameAR: String(200) );
create or modify non-persistent entity Bug1744.Choice ( Note: String(20), Code: String(200) );
create or modify association Bug1744.Choice_Person from Bug1744.Choice to Bug1744.Person type Reference owner Default;

create or modify microflow Bug1744.DS_Choice () returns Bug1744.Choice as $Choice
begin
  $Made = create Bug1744.Choice ( Note = '' );
  return $Made;
end;

create or modify page Bug1744.ChoosePage ( Title: 'Choose', Layout: Atlas_Core.Atlas_Default ) {
  dataview dvChoice (DataSource: microflow Bug1744.DS_Choice) {
    -- The reported script: association mode, two attributes per option.
    combobox cbPerson (
      Label: 'Person',
      Association: Bug1744.Choice_Person,
      DataSource: database Bug1744.Person,
      CaptionAttribute: NameEN,
      optionsSourceAssociationCustomContentType: 'yes'
    ) {
      optionssourceassociationcustomcontent {
        dynamictext ccEn (Content: '{1}', ContentParams: ({1} = NameEN), RenderMode: H6)
        dynamictext ccAr (Content: '{1}', ContentParams: ({1} = NameAR), RenderMode: H6)
      }
    }
    -- Database mode: the option list is the combo box's own datasource, and the
    -- chosen option's NameEN is stored on Choice.Code.
    combobox cbCode (
      Label: 'Code',
      optionsSourceDatabaseDataSource: database from Bug1744.Person,
      Attribute: Code,
      CaptionAttribute: NameEN,
      optionsSourceDatabaseValueAttribute: NameEN,
      optionsSourceDatabaseCustomContentType: 'yes'
    ) {
      optionssourcedatabasecustomcontent {
        dynamictext ccCode (Content: '{1} / {2}', ContentParams: ({1} = NameEN, {2} = NameAR))
      }
    }
    -- Content with the type left out: the type is written 'yes'. Left at its
    -- default 'no' the content was hidden, which mx check reported as CE0463.
    -- The type without content is the .fail.mdl beside this file.
    combobox cbPerson2 (
      Label: 'Person (no type)',
      Association: Bug1744.Choice_Person,
      DataSource: database Bug1744.Person,
      CaptionAttribute: NameEN
    ) {
      optionssourceassociationcustomcontent {
        dynamictext ccEn2 (Content: '{1}', ContentParams: ({1} = NameEN))
      }
    }
  }
};

describe page Bug1744.ChoosePage;
