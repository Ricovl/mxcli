mdl 1;
-- ============================================================================
-- Upstream #863 (follow-up): EXECUTE DATABASE QUERY described as
-- `-- Empty action` — write-only, on the default engine
-- ============================================================================
--
-- The action is authorable in MDL and already had a DESCRIBE formatter. Only the
-- modelsdk reader's mapping was missing, so the activity wrote correctly and
-- read back with a nil Action:
--
--   -- Unsupported action: DatabaseConnector$ExecuteDatabaseQueryAction
--   -- on error without rollback begin
--   --   log error node 'Application' 'query failed';
--   -- end error;
--
-- (That output is itself the #863 fix working — before it, the same activity
-- said "-- Empty action" and the error handler was gone entirely.)
--
-- Storage note: the $Type is DatabaseConnector$ExecuteDatabaseQueryAction, NOT
-- Microflows$ — the action lives in its own sub-metamodel, which is why probing
-- for it under the Microflows$ prefix proves nothing either way.
--
-- CREDENTIALS MUST BE CONSTANTS. `connection string` / `username` / `password`
-- are ConstantIdentifier properties. The grammar also accepts a string literal
-- there, and writing one produces a project Mendix CANNOT LOAD:
--
--   StorageLoadException: ... has an invalid value '' for property
--   ConnectionString. The text 'jdbc:...' is not a valid ConstantIdentifier.
--
-- That is a separate, still-open mxcli defect (same class as #854) — the form
-- below is the one that works.
--
-- Verified on Mendix 11.13.0: the project loads, describe→exec→describe is
-- byte-stable, and the only remaining check error is CE5278 (the PostgreSQL JDBC
-- driver is not in module settings), which is a dependency the example does not
-- ship rather than a model defect.
-- ============================================================================

create module DbQ863;
create persistent entity DbQ863.Row (N: Integer);

create constant DbQ863.DbUrl  ( Type: String, DefaultValue: 'jdbc:postgresql://localhost:5432/app' );
create constant DbQ863.DbUser ( Type: String, DefaultValue: 'app' );
create constant DbQ863.DbPass ( Type: String, DefaultValue: 'secret' );

create database connection DbQ863.Conn (
  Type: 'PostgreSQL',
  ConnectionString: @DbQ863.DbUrl,
  Username: @DbQ863.DbUser,
  Password: @DbQ863.DbPass
) {
  query GetRows (
    Sql: 'select n from rows where status = $Status',
    Parameters: ( Status: String ),
    Returns: DbQ863.Row, Map: (N = n)
  )
};

create microflow DbQ863.MF_Query ($Status: String)
begin
  $Rows = execute database query DbQ863.Conn.GetRows (Status = $Status) on error without rollback begin
    log error 'query failed';
  end error;
end;
