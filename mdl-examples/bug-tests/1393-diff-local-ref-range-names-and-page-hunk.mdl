mdl 1;
-- mendixlabs/mxcli#1393 — `mxcli diff-local --ref HEAD~1..HEAD` printed
--     --- Microflow.56594ae3-d5b7-42cd-b230-ffc330b1b8b2 (current)
--     +++ Microflow.56594ae3-d5b7-42cd-b230-ffc330b1b8b2 (script)
-- rendered the microflow as `microflow .ACT_NoteFieldRun` (module dropped),
-- and a page whose container gained a conditional Visible reported
-- "Summary: 0 new, 1 modified, 0 deleted" with no hunk.
--
-- Causes: an MPR v2 .mxunit does not hold its container (the .mpr's Unit
-- table does), so the module lookup never hit and the header used the file
-- UUID; the labels were the script diff's, hard-coded; and pages rendered a
-- fixed "-- (page widgets)" body, so any widget change rendered identically.
--
-- Repro on an MPR v2 app in git:
--   1. mxcli exec this script, commit.
--   2. Change the log message below to 'after', and give box1 `Visible: false`
--      (uncomment the second page), exec, commit.
--   3. mxcli diff-local -p App.mpr --ref HEAD~1..HEAD
-- After the fix the headers read
--     --- Microflow.MyFirstModule.ACT_NoteFieldRun (HEAD~1)
--     +++ Microflow.MyFirstModule.ACT_NoteFieldRun (HEAD)
-- and the page shows a one-line hunk for `container box1 (Visible: false)`.

create or modify microflow MyFirstModule.ACT_NoteFieldRun ()
begin
  log info 'before';
end;

create or modify page MyFirstModule.Note_Overview (
  Title: 'Notes',
  Layout: Atlas_Core.Atlas_Default
) {
  container box1 {
  }
};

-- Step 2:
-- create or modify page MyFirstModule.Note_Overview (
--   Title: 'Notes',
--   Layout: Atlas_Core.Atlas_Default
-- ) {
--   container box1 (Visible: false) {
--   }
-- };
