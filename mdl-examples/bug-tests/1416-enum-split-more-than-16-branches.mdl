mdl 1;
-- ============================================================================
-- #1416 - an enum split of more than 16 branches is created, not refused
-- ============================================================================
--
-- POSITIVE TEST: `mxcli check` (with and without -p) and `exec` MUST accept it.
--
-- Studio Pro writes enum splits far wider than 16 branches (the FSM template's
-- NativeModelCheck_Process has 28 values), and DESCRIBE prints them, but check -p
-- and exec refused them: "enum split has 29 branches; at most 16 branches are
-- supported". The 16 was the size of the anchor-pair table that once carried the
-- case order; a split of four or more cases now stores the order as origin side
-- plus canvas depth, so the limit was a leftover. 28 values + (empty) = 29.

CREATE MODULE Bug1416;

CREATE OR MODIFY ENUMERATION Bug1416.Step (
  S01 'S01',
  S02 'S02',
  S03 'S03',
  S04 'S04',
  S05 'S05',
  S06 'S06',
  S07 'S07',
  S08 'S08',
  S09 'S09',
  S10 'S10',
  S11 'S11',
  S12 'S12',
  S13 'S13',
  S14 'S14',
  S15 'S15',
  S16 'S16',
  S17 'S17',
  S18 'S18',
  S19 'S19',
  S20 'S20',
  S21 'S21',
  S22 'S22',
  S23 'S23',
  S24 'S24',
  S25 'S25',
  S26 'S26',
  S27 'S27',
  S28 'S28'
);

CREATE OR MODIFY MICROFLOW Bug1416.Route ($Step: Enumeration(Bug1416.Step))
RETURNS String
BEGIN
  case $Step
    when S01 then
      return 's01';
    when S02 then
      return 's02';
    when S03 then
      return 's03';
    when S04 then
      return 's04';
    when S05 then
      return 's05';
    when S06 then
      return 's06';
    when S07 then
      return 's07';
    when S08 then
      return 's08';
    when S09 then
      return 's09';
    when S10 then
      return 's10';
    when S11 then
      return 's11';
    when S12 then
      return 's12';
    when S13 then
      return 's13';
    when S14 then
      return 's14';
    when S15 then
      return 's15';
    when S16 then
      return 's16';
    when S17 then
      return 's17';
    when S18 then
      return 's18';
    when S19 then
      return 's19';
    when S20 then
      return 's20';
    when S21 then
      return 's21';
    when S22 then
      return 's22';
    when S23 then
      return 's23';
    when S24 then
      return 's24';
    when S25 then
      return 's25';
    when S26 then
      return 's26';
    when S27 then
      return 's27';
    when S28 then
      return 's28';
    when (empty) then
      return 'none';
  end case;
END;
