mdl 1;

/**
 * mendixlabs/mxcli#1395: "mxcli describe --help and the catalog.db still use the
 * old names" after the document types took Studio Pro's names (ako/mxcli#755).
 *
 * The catalog answers under the Studio Pro names, and OBJECTS reports them as
 * ObjectType. The old table names (REST_CLIENTS, REST_OPERATIONS, ODATA_CLIENTS,
 * ODATA_SERVICES, QUEUES) still answer as aliases but are no longer listed.
 *
 * `mxcli describe` takes the same names: consumedrestservice / "consumed rest
 * service", consumedodataservice, publishedodataservice, taskqueue, aimodel,
 * appsecurity; the old spellings stay accepted.
 */

select QualifiedName, BaseUrl, OperationCount from catalog.CONSUMED_REST_SERVICES;
select ServiceQualifiedName, HttpMethod, Path from catalog.CONSUMED_REST_OPERATIONS;
select QualifiedName, MetadataUrl from catalog.CONSUMED_ODATA_SERVICES;
select QualifiedName, Path from catalog.PUBLISHED_ODATA_SERVICES;
select QualifiedName, Parallelism from catalog.TASK_QUEUES;

select ObjectType, QualifiedName
from catalog.OBJECTS
where ObjectType in ('CONSUMED_REST_SERVICE', 'CONSUMED_ODATA_SERVICE',
  'PUBLISHED_ODATA_SERVICE', 'TASK_QUEUE');
