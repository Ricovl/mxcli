-- mendixlabs/mxcli#1103 — `retrieve … limit 1` binds a single OBJECT.
--
-- This script has no `mdl 1;` header, so `limit 1` with no offset keeps its
-- alpha meaning, Mendix's "First object" range (and warns MDL-V1-LIMIT1,
-- ako/mxcli#734): $Requests is an object and head() cannot take it. mxbuild
-- rejects that as CE0097 — and inside a .test.mdl file, not even that: the
-- injected test simply failed to build. `describe` now prints the object
-- range as `first`; under `mdl 1;` `limit 1` is a list of one.
--
-- MDL-RETRIEVE01 reports it at check time. This script must FAIL check.
create module Probe;

create entity Probe.Request (
  Code: String(20)
);

create or replace microflow Probe.M_LimitOneAsList ()
returns Boolean as $Found
begin
  declare $Found Boolean = false;
  retrieve $Requests from Probe.Request where Code = 'X' limit 1;
  $Request = head($Requests);
  set $Found = $Request != empty;
  return $Found;
end;
/
