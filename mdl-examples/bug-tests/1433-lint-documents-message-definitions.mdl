mdl 1;
-- ============================================================================
-- ako/mxcli#1433 (mendixlabs/mxcli#1535) — documents() never returned message
-- definitions
-- ============================================================================
--
-- Reported: "A message definition collection created with MDL does not appear
-- in documents(), so a rule on its name (for example a required MD_ prefix)
-- can never fire."
--
-- The catalog had no table for either storage shape, so the objects view that
-- documents() reads never held one. It now has message_definition_collections
-- (MESSAGE_DEFINITION_COLLECTION, Mendix < 11.15) and message_definitions
-- (MESSAGE_DEFINITION, the 11.15 MessageDefinition2 document).
--
-- The assertion is a Go test (mdl/linter/documents_message_definitions_test.go):
-- the symptom is in the lint API, which `make check-mdl` does not exercise. To
-- reproduce by hand, run this script, then lint a rule returning
--   [violation(message = d.qualified_name) for d in documents()
--    if d.kind == "MESSAGE_DEFINITION_COLLECTION" and not d.name.startswith("MD_")]
-- It must report Msg.Orders.
-- ============================================================================

create module Msg;

create persistent entity Msg.Order (
  Code: String(20)
);

create message definition collection Msg.Orders {
  definition Order for Msg.Order {
    Code
  }
};
