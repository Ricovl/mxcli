mdl 1;
-- ako/mxcli#1512 (mendixlabs/mxcli#1602) — after a settings change,
-- `mxcli diff-local` printed only
--     Summary: 0 new, 1 modified, 0 deleted
-- and `--format struct` said "(no changes)". The project settings unit had no
-- renderer: it fell to the generic case, two comment lines naming the unit
-- type, which read the same at every revision.
--
-- The settings unit now renders with DESCRIBE SETTINGS' own writer, with
-- configuration constant values masked. And any unit whose rendering is the
-- same at both revisions (navigation, project or module security, a page's
-- access, an entity index, …) is printed as one line naming the properties
-- that changed, instead of nothing.
--
-- Repro on an MPR v2 app in git:
--   1. mxcli exec this script, commit.
--   2. Run the commented statements below (uncommented), then from the app's
--      folder: mxcli diff-local -p App.mpr   (and with --format struct)
-- Expected after the fix:
--     -alter settings constant 'MyFirstModule.DiffLocalApiKey' value <masked: old value>
--     +alter settings constant 'MyFirstModule.DiffLocalApiKey' value <masked: new value>
--     -  BcryptCost: 12,          (or whatever the app had)
--     +  BcryptCost: 11,
--     Modified: ModuleSecurity MyFirstModule: changed in properties the MDL
--       rendering does not show: ModuleRoles (1 -> 2 items)
-- and neither constant value appears anywhere in the output.

create or modify constant MyFirstModule.DiffLocalApiKey (Type: String, DefaultValue: 'x');
alter settings constant @MyFirstModule.DiffLocalApiKey value 'first-secret' in configuration 'Default';

-- Step 2:
-- alter settings constant @MyFirstModule.DiffLocalApiKey value 'secret123' in configuration 'Default';
-- alter settings runtime (BcryptCost: 11);
-- create module role MyFirstModule.DiffLocalReviewer;
