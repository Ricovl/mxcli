mdl 1;
-- mendixlabs/mxcli#1630 (ako/mxcli#1562) — after a script that only changes
-- an entity's access, `mxcli diff-local` printed
--     Summary: 0 new, 1 modified, 0 deleted
-- and no hunk. The domain model renderer printed entities and attributes but
-- not their access rules, so both sides rendered identically.
--
-- Repro on an MPR v2 app in git whose MyFirstModule has the User module role
-- (testdata/pedapp does):
--   1. mxcli exec this script, commit.
--   2. Uncomment the step-2 grant below (comment out the step-1 grant), exec.
--   3. mxcli diff-local -p App.mpr
-- After the fix the domain model shows
--     -grant read * on entity MyFirstModule.Customer to MyFirstModule.User;
--     +grant read *, write * on entity MyFirstModule.Customer to MyFirstModule.User;

create or modify persistent entity MyFirstModule.Customer (
  Name: String(100)
);

-- Step 1:
grant read * on entity MyFirstModule.Customer to MyFirstModule.User;

-- Step 2:
-- grant read *, write * on entity MyFirstModule.Customer to MyFirstModule.User;
