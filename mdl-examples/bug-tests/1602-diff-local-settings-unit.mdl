mdl 1;
-- mendixlabs/mxcli#1602 (ako/mxcli#1512) — after an ALTER SETTINGS, `mxcli
-- diff-local` printed
--     Summary: 0 new, 1 modified, 0 deleted
-- and with -f struct `ProjectSettings: <unit>` / `(no changes)`. bsonToMDL had
-- no case for the project-settings unit, so both sides fell into the generic
-- one-line header, which reads the same before and after.
--
-- Repro on an MPR v2 app in git:
--   1. mxcli exec this script, commit.
--   2. Uncomment the step-2 statements below (comment out step 1's), exec.
--   3. mxcli diff-local -p App.mpr
-- After the fix the settings unit shows the changed `BcryptCost` line and the
-- constant's line with its value masked, e.g.
--     +alter settings constant 'MyFirstModule.ApiKey' value <masked #e0f7f850>
-- The value itself ('secret123') must not appear in the output.

create or modify constant MyFirstModule.ApiKey type String default 'x';

-- Step 1:
ALTER SETTINGS CONSTANT @MyFirstModule.ApiKey VALUE 'x' IN CONFIGURATION 'Default';
ALTER SETTINGS RUNTIME (BcryptCost: 10);

-- Step 2:
-- ALTER SETTINGS CONSTANT @MyFirstModule.ApiKey VALUE 'secret123' IN CONFIGURATION 'Default';
-- ALTER SETTINGS RUNTIME (BcryptCost: 11);
